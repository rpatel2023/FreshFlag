rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function householdPath(householdId) {
      return /databases/$(database)/documents/households/$(householdId);
    }

    function memberPath(householdId, uid) {
      return /databases/$(database)/documents/households/$(householdId)/members/$(uid);
    }

    function invitePath(inviteId) {
      return /databases/$(database)/documents/invites/$(inviteId);
    }

    function isHouseholdMember(householdId) {
      return signedIn() && exists(memberPath(householdId, request.auth.uid));
    }

    function householdRole(householdId) {
      return isHouseholdMember(householdId)
        ? get(memberPath(householdId, request.auth.uid)).data.role
        : null;
    }

    function isHouseholdOwner(householdId) {
      return householdRole(householdId) == 'owner';
    }

    function isHouseholdManager(householdId) {
      let role = householdRole(householdId);
      return role == 'owner' || role == 'admin';
    }

    function canWriteInventory(householdId) {
      let role = householdRole(householdId);
      return role == 'owner' || role == 'admin' || role == 'member';
    }

    function validInvite(inviteId, householdId) {
      return signedIn() &&
        inviteId is string &&
        exists(invitePath(inviteId)) &&
        get(invitePath(inviteId)).data.householdId == householdId &&
        get(invitePath(inviteId)).data.status == 'active' &&
        request.time < get(invitePath(inviteId)).data.expiresAt;
    }

    function validSelfJoin(householdId) {
      return signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['memberUids', 'updatedAt', 'lastJoinInviteId']) &&
        !(request.auth.uid in resource.data.memberUids) &&
        request.auth.uid in request.resource.data.memberUids &&
        request.resource.data.memberUids.hasAll(resource.data.memberUids) &&
        request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1 &&
        validInvite(request.resource.data.lastJoinInviteId, householdId);
    }

    function validReminderRule(data) {
      return data.daysBefore is int &&
        data.daysBefore >= 0 &&
        data.daysBefore <= 365 &&
        data.titleTemplate is string &&
        data.titleTemplate.size() > 0 &&
        data.bodyTemplate is string &&
        data.bodyTemplate.size() > 0 &&
        data.sendTime is string &&
        data.sendTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
        data.enabled is bool;
    }

    match /users/{uid} {
      allow read, create, update, delete: if isSelf(uid);

      match /devices/{deviceId} {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid) &&
          request.resource.data.deviceId == deviceId;
        allow delete: if isSelf(uid);
      }
    }

    match /households/{householdId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;

      allow create: if signedIn() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.memberUids.size() == 1 &&
        request.resource.data.memberUids[0] == request.auth.uid;

      allow update: if (
          isHouseholdOwner(householdId) &&
          request.resource.data.ownerUid == resource.data.ownerUid
        ) || validSelfJoin(householdId);

      allow delete: if isHouseholdOwner(householdId);

      match /members/{uid} {
        allow read: if isHouseholdMember(householdId);

        allow create: if (
            signedIn() &&
            uid == request.auth.uid &&
            request.resource.data.uid == request.auth.uid &&
            request.resource.data.role == 'owner' &&
            getAfter(householdPath(householdId)).data.ownerUid == request.auth.uid
          ) || (
            signedIn() &&
            uid == request.auth.uid &&
            request.resource.data.uid == request.auth.uid &&
            request.resource.data.role == 'member' &&
            validInvite(request.resource.data.inviteId, householdId)
          );

        // Role changes/removals are backend-managed so the member document and
        // household memberUids array cannot drift apart.
        allow update, delete: if false;
      }

      match /items/{itemId} {
        allow read: if isHouseholdMember(householdId);

        allow create: if canWriteInventory(householdId) &&
          request.resource.data.householdId == householdId &&
          request.resource.data.createdByUid == request.auth.uid &&
          request.resource.data.updatedByUid == request.auth.uid;

        allow update: if canWriteInventory(householdId) &&
          request.resource.data.householdId == householdId &&
          request.resource.data.householdId == resource.data.householdId &&
          request.resource.data.createdByUid == resource.data.createdByUid &&
          request.resource.data.updatedByUid == request.auth.uid;

        allow delete: if canWriteInventory(householdId);
      }

      match /notificationRules/{ruleId} {
        allow read: if isHouseholdMember(householdId);
        allow create, update: if isHouseholdManager(householdId) &&
          validReminderRule(request.resource.data);
        allow delete: if isHouseholdManager(householdId);
      }
    }

    match /invites/{inviteId} {
      allow get: if signedIn() &&
        resource.data.status == 'active' &&
        request.time < resource.data.expiresAt;
      allow list: if false;

      allow create: if signedIn() &&
        isHouseholdManager(request.resource.data.householdId) &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.status == 'active' &&
        request.resource.data.expiresAt > request.time;

      allow update, delete: if isHouseholdManager(resource.data.householdId);
    }

    match /userIntegrations/{uid} {
      allow read, write: if false;
    }

    match /householdIntegrations/{householdId} {
      allow read, write: if false;
    }

    match /notificationDeliveries/{deliveryId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

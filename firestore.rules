rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function householdPath(householdId) {
      return /databases/$(database)/documents/households/$(householdId);
    }

    function memberPath(householdId, uid) {
      return /databases/$(database)/documents/households/$(householdId)/members/$(uid);
    }

    function invitePath(inviteId) {
      return /databases/$(database)/documents/invites/$(inviteId);
    }

    function isHouseholdMember(householdId) {
      return signedIn() && exists(memberPath(householdId, request.auth.uid));
    }

    function isHouseholdOwner(householdId) {
      return isHouseholdMember(householdId) &&
        get(memberPath(householdId, request.auth.uid)).data.role == 'owner';
    }

    function validInvite(inviteId, householdId) {
      return signedIn() &&
        inviteId is string &&
        exists(invitePath(inviteId)) &&
        get(invitePath(inviteId)).data.householdId == householdId &&
        get(invitePath(inviteId)).data.status == 'active' &&
        request.time < get(invitePath(inviteId)).data.expiresAt;
    }

    function validSelfJoin(householdId) {
      return signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['memberUids', 'updatedAt', 'lastJoinInviteId']) &&
        !(request.auth.uid in resource.data.memberUids) &&
        request.auth.uid in request.resource.data.memberUids &&
        request.resource.data.memberUids.hasAll(resource.data.memberUids) &&
        request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1 &&
        validInvite(request.resource.data.lastJoinInviteId, householdId);
    }

    match /users/{uid} {
      allow read, create, update, delete: if isSelf(uid);
    }

    match /households/{householdId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;

      allow create: if signedIn() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.memberUids.size() == 1 &&
        request.resource.data.memberUids[0] == request.auth.uid;

      allow update: if (
          isHouseholdOwner(householdId) &&
          request.resource.data.ownerUid == resource.data.ownerUid
        ) || validSelfJoin(householdId);

      allow delete: if isHouseholdOwner(householdId);

      match /members/{uid} {
        allow read: if isHouseholdMember(householdId);

        allow create: if (
            signedIn() &&
            uid == request.auth.uid &&
            request.resource.data.uid == request.auth.uid &&
            request.resource.data.role == 'owner' &&
            getAfter(householdPath(householdId)).data.ownerUid == request.auth.uid
          ) || (
            signedIn() &&
            uid == request.auth.uid &&
            request.resource.data.uid == request.auth.uid &&
            request.resource.data.role == 'member' &&
            validInvite(request.resource.data.inviteId, householdId)
          );

        allow update, delete: if isHouseholdOwner(householdId);
      }

      match /items/{itemId} {
        allow read: if isHouseholdMember(householdId);

        allow create: if isHouseholdMember(householdId) &&
          request.resource.data.householdId == householdId &&
          request.resource.data.createdByUid == request.auth.uid &&
          request.resource.data.updatedByUid == request.auth.uid;

        allow update: if isHouseholdMember(householdId) &&
          request.resource.data.householdId == householdId &&
          request.resource.data.householdId == resource.data.householdId &&
          request.resource.data.createdByUid == resource.data.createdByUid &&
          request.resource.data.updatedByUid == request.auth.uid;

        allow delete: if isHouseholdMember(householdId);
      }
    }

    match /invites/{inviteId} {
      // Invite IDs are high-entropy share codes. Signed-in users may only fetch
      // a code they already possess; collection enumeration is denied.
      allow get: if signedIn() &&
        resource.data.status == 'active' &&
        request.time < resource.data.expiresAt;
      allow list: if false;

      allow create: if signedIn() &&
        isHouseholdOwner(request.resource.data.householdId) &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.status == 'active' &&
        request.resource.data.expiresAt > request.time;

      allow update, delete: if isHouseholdOwner(resource.data.householdId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
